#!/bin/sh /etc/rc.common
# 【2026-10-31.1345】固件版本标记 —— 与 crowdsec-lxc-bootstrap.sh 的 SCRIPT_VER 同步，每次改脚本一起改
# crowdsec-lxc-probe：运行期 last_pull 监视探针服务壳（v.82）
# 本体 /usr/sbin/crowdsec-lxc-probe.sh：只验证 last_pull，停滞则持引导锁
# 拉起 crowdsec-lxc-bootstrap.sh 复验/修复。开机自启（START=99，早于 rc.local
# 收尾）：重启态直接进监视；首启时安装未完成则探针静默等待 installed 标记。

# 【v.180.78】固件版本号。五个脚本统一用 SCRIPT_VER 一个名字，
# 一条命令就能全查出来：
#   grep -H -m1 '^SCRIPT_VER=' /usr/sbin/crowdsec-*.sh /etc/rc.local \
#        /etc/init.d/crowdsec-lxc-probe
# 只有 crowdsec-lxc-bootstrap.sh 的那一份参与 CFG_SHA_FILE 指纹判定；
# 这里这份纯标记，改它不会触发任何重写。
SCRIPT_VER="2026.11.10"

START=99
USE_PROCD=1

start_service() {
    # 起服务前先复原核心脚本。本文件自己也在保护表里，被改过时靠 rc.local 和探针补回；
    # guard 不负责它自己（被改成 exit 0 就什么都不会复原），所以调用前先自举。
    local _g=/usr/sbin/crowdsec-guard.sh
    if [ -f "/rom$_g" ] && ! cmp -s "/rom$_g" "$_g" 2>/dev/null; then
        rm -f "$_g"
        cp -f "/rom$_g" "$_g" 2>/dev/null
        chmod 755 "$_g" 2>/dev/null
    fi
    # 【v.108.67】加硬顶：guard 自身有 3 次 attach × 10s，正常几百 ms；
    # 卡住时不能让 procd 的 start_service 一起挂着（那会连探针都起不来）。
    # 【2026-11-10.0432】固件里没有 timeout 时直接跑：guard 自身有 3 次 attach × 10s
    # 的内建硬顶，procd 的 start_service 不会被无限挂住；有 timeout 就照旧带 60s 上限。
    # 原来这一行恒返回 127，日志里那条「/etc/rc.common: line 30: timeout: not found」
    # 就是它 —— 等于 guard 一次都没跑过，脚本自愈全程静默。
    if [ -x "$_g" ]; then
        if command -v timeout >/dev/null 2>&1; then
            timeout 60 "$_g" quiet
        else
            "$_g" quiet
        fi
    fi

    procd_open_instance
    procd_set_param command /usr/sbin/crowdsec-lxc-probe.sh
    procd_set_param respawn
    procd_close_instance
}
